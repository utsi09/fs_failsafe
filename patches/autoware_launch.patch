diff --git a/autoware_launch/config/system/diagnostics/autoware-carla.yaml b/autoware_launch/config/system/diagnostics/autoware-carla.yaml
index 4f05e99..84a1ff6 100644
--- a/autoware_launch/config/system/diagnostics/autoware-carla.yaml
+++ b/autoware_launch/config/system/diagnostics/autoware-carla.yaml
@@ -45,6 +45,8 @@ units:
       - { type: link, link: /autoware/vehicle }
       - { type: link, link: /autoware/system }
       - { type: link, link: /adapi/mrm_request/delegate }
+      - { type: link, link: /autoware/cdr/perception_score }
+      - { type: link, link: /autoware/cdr/supervisor_defer }
 
   - path: /autoware/modes/pull_over
     type: and
@@ -123,6 +125,26 @@ units:
     name: delegate
     timeout: 3.0
 
+  # cdr_monitor dynamic-FTTI perception score (fs_ws thesis failsafe).
+  # ERROR (score <= 0.3) makes /autoware/modes/autonomous unavailable ->
+  # mrm_handler triggers MRM. WARN (0.3..0.7) stays available so the
+  # mrm_supervisor reroute owns that band. Requires cdr_monitor running,
+  # otherwise this unit goes stale and autonomous cannot engage.
+  - path: /autoware/cdr/perception_score
+    type: diag
+    node: cdr_monitor
+    name: sensing/perception_score
+    timeout: 3.0
+
+  # mrm_supervisor DEFER hand-over: ERROR while the supervisor is in
+  # MRM_DEFER (TL gate / low localization / score floor) so the stock
+  # mrm_handler takes over with comfortable/emergency stop.
+  - path: /autoware/cdr/supervisor_defer
+    type: diag
+    node: mrm_supervisor
+    name: defer_request
+    timeout: 3.0
+
   # Planning units (without routing/state check for CARLA)
   - path: /autoware/planning
     type: and
