 {
   const auto & p = current_pose.position;
-  const lanelet::Point3d ego_point(lanelet::InvalId, p.x, p.y, p.z);
+  const lanelet::BasicPoint2d ego_point(p.x, p.y);
   const auto & g = goal_pose.position;
   const lanelet::Point3d goal_point(lanelet::InvalId, g.x, g.y, g.z);
 
+  // [v4.5 데드락 픽스] within(ego) 이진 판정은 NPC에 막혀 폴리곤 1~2 m 밖에서
+  // 정지하거나(gn-def t=40 실측) goal 재송신 리셋 중 폴리곤을 통과해버리면(t=23)
+  // 영영 못 켜진다. goal을 품은 폴리곤까지 거리 8 m 이내면 도착으로 판정 —
+  // 원래 막던 원거리 조기 전환(goal이 costmap 70 m 밖)은 8 m에선 성립 불가,
+  // same-lot 조건(goal이 그 폴리곤 안)은 그대로 유지된다.
+  static constexpr double th_arrive_dist_m = 8.0;
+  const auto dist_to_polygon = [](const lanelet::BasicPoint2d & pt,
+                                  const lanelet::BasicPolygon3d & poly) {
+    double min_d = std::numeric_limits<double>::max();
+    const size_t n = poly.size();
+    for (size_t i = 0; i < n; ++i) {
+      const auto & a = poly[i];
+      const auto & b = poly[(i + 1) % n];
+      const double abx = b.x() - a.x(), aby = b.y() - a.y();
+      const double apx = pt.x() - a.x(), apy = pt.y() - a.y();
+      const double len2 = abx * abx + aby * aby;
+      const double t = len2 > 0.0 ? std::clamp((apx * abx + apy * aby) / len2, 0.0, 1.0) : 0.0;
+      const double dx = apx - t * abx, dy = apy - t * aby;
+      min_d = std::min(min_d, std::hypot(dx, dy));
+    }
+    return min_d;
+  };
+  const lanelet::Point3d ego_point3d(lanelet::InvalId, p.x, p.y, p.z);
   const auto parking_lots =
     lanelet::utils::query::getAllParkingLots(lanelet_map_ptr);
   for (const auto & lot : parking_lots) {
+    if (!lanelet::geometry::within(goal_point, lot.basicPolygon())) {
+      continue;
+    }
     if (
-      lanelet::geometry::within(ego_point, lot.basicPolygon()) &&
-      lanelet::geometry::within(goal_point, lot.basicPolygon())) {
+      lanelet::geometry::within(ego_point3d, lot.basicPolygon()) ||
+      dist_to_polygon(ego_point, lot.basicPolygon()) < th_arrive_dist_m) {
       return true;
     }
   }
